    {
      "id": "IX5_Sl5YVO4XGRgx5EXTn",
      "type": "text",
      "x": -4856.2885558778635,
      "y": -1154.6607507800525,
      "width": 943.1338224835646,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
