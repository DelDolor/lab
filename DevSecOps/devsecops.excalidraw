      "boundElements": null,
      "updated": 1760111853412,
      "link": null,
      "locked": false,
      "text": "VM pohjautuu imageen, joka on\nhaettu yksityisestä rekisteristä.\nNämä artifaktit on tulleet\nluotetun julkaisuautomaation\nkautta ja ne on allekirjoitettu",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "4Z_7QeBQgOR2KVGF89x81",
      "originalText": "VM pohjautuu imageen, joka on haettu yksityisestä rekisteristä.\nNämä artifaktit on tulleet luotetun julkaisuautomaation kautta ja ne on allekirjoitettu",
      "autoResize": true,
      "lineHeight": 1.25
    },
