      "seed": 1177814298,
      "version": 876,
      "versionNonce": 2000468442,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1757415499035,
      "link": null,
      "locked": false,
      "text": "- Jatkaa siitä mihin CI pipelinessä päästiin\n- Puskee muutokset automaattisesti testiympäristöön\n- Ajaa automaattisia testej\n- Voi sisältää manuaalisia tarkastuksia/hyväksyntöjä\n- Vaiheet lokitetaan ja saadaan audit trail checkin vaiheesta deploymentiin\n- Failuret pysäyttää pipelinen\n- uusia muutoksia ei hyväksytä ennen kuin aiemmat virheet on korjattu. Tämä varmistaa\nettä koodi on aina valmis deployattavaksi.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Jatkaa siitä mihin CI pipelinessä päästiin\n- Puskee muutokset automaattisesti testiympäristöön\n- Ajaa automaattisia testej\n- Voi sisältää manuaalisia tarkastuksia/hyväksyntöjä\n- Vaiheet lokitetaan ja saadaan audit trail checkin vaiheesta deploymentiin\n- Failuret pysäyttää pipelinen\n- uusia muutoksia ei hyväksytä ennen kuin aiemmat virheet on korjattu. Tämä varmistaa että koodi on aina valmis deployattavaksi.",
      "autoResize": false,
      "lineHeight": 1.25
    },
