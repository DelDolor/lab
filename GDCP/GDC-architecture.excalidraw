    {
      "id": "LvbPCmUVfx5isb0itU3Ko",
      "type": "text",
      "x": -440.7558543582413,
      "y": -2446.346941082046,
      "width": 899.0513916015625,
      "height": 340.20000000000005,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTF",
      "roundness": null,
      "seed": 474971823,
      "version": 925,
      "versionNonce": 1832582127,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762259721254,
      "link": null,
      "locked": false,
      "text": "1. Käyttäjä kirjautuu IdP:tä vasten\n2. IdP varmistaa autentikaatiopyynnössä tulleet credentiaalit\nja palauttaa OIDC identity tokenin\n3. Käyttäjä välittää saamansa OIDC tokenin Cloud IAM:lle \nja väliaikaisen autentikaatiotokenin\n4. Cloud IAM varmistaa saamansa OIDC tokenin IdP:ltä\n5. Kun kaikki on kunnossa, palauttaa Cloud IAM käyttäjälle\nväliaikaisen (ajallisesti lyhyt ikäinen) tokenin\n6. Käyttäjä kirjautuu saamallaan tokenilla palveluihin joihin oli menossa",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Käyttäjä kirjautuu IdP:tä vasten\n2. IdP varmistaa autentikaatiopyynnössä tulleet credentiaalit\nja palauttaa OIDC identity tokenin\n3. Käyttäjä välittää saamansa OIDC tokenin Cloud IAM:lle \nja väliaikaisen autentikaatiotokenin\n4. Cloud IAM varmistaa saamansa OIDC tokenin IdP:ltä\n5. Kun kaikki on kunnossa, palauttaa Cloud IAM käyttäjälle\nväliaikaisen (ajallisesti lyhyt ikäinen) tokenin\n6. Käyttäjä kirjautuu saamallaan tokenilla palveluihin joihin oli menossa",
      "autoResize": true,
      "lineHeight": 1.35
    },
