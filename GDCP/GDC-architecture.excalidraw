      "isDeleted": false,
      "boundElements": null,
      "updated": 1762080914729,
      "link": null,
      "locked": false,
      "text": "Klusterit on organisaatiokohtaisia ja niiden pitää kuulua yhteen tai useampaan projektiin.\nKubernetes (user) klusteri ole pakollinen jos projekti koostuu pelkästään VM resursseista.\nKlusteri on zonaalinen palvelu ja multi-zone arkkitehtuuria varten klusterit pitää tehdä joka zonelle.\nSama projekti voi laajeta useaan klusteriin.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Klusterit on organisaatiokohtaisia ja niiden pitää kuulua yhteen tai useampaan projektiin.\nKubernetes (user) klusteri ole pakollinen jos projekti koostuu pelkästään VM resursseista.\nKlusteri on zonaalinen palvelu ja multi-zone arkkitehtuuria varten klusterit pitää tehdä joka zonelle.\nSama projekti voi laajeta useaan klusteriin.",
      "autoResize": true,
      "lineHeight": 1.35
    }
