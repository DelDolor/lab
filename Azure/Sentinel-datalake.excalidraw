    {
      "id": "wKRshw196Rv-3GmK_7nmB",
      "type": "text",
      "x": -1785.2324118768875,
      "y": 1032.394399886103,
      "width": 649,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b44",
      "roundness": null,
      "seed": 518517877,
      "version": 711,
      "versionNonce": 773376923,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756792306523,
      "link": null,
      "locked": false,
      "text": "Take whole original log and store it to logsource\n- can be used for analytics and alerting\n- Can use built in analytic rules that comes with solutions\n- Can project-away fields if neccessary\n- no need to move to datalake after retention period, \nbecouse this data is already there in custom schema ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Take whole original log and store it to logsource\n- can be used for analytics and alerting\n- Can use built in analytic rules that comes with solutions\n- Can project-away fields if neccessary\n- no need to move to datalake after retention period, \nbecouse this data is already there in custom schema ",
      "autoResize": true,
      "lineHeight": 1.25
    },
